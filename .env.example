# ─────────────────────────────────────────────────────────────────────────────
# Telegram Post Forward Bot — environment variable template
# Copy this file to .env and fill in your values.
# NEVER commit your real .env file.
# ─────────────────────────────────────────────────────────────────────────────

# Required: get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Optional: comma-separated Telegram user IDs allowed to use admin commands.
# Leave empty to allow everyone (useful for first-time setup — add yourself then lock it down).
TELEGRAM_ADMIN_IDS=123456789,987654321

# Optional: source channel ID — posts here are auto-forwarded to all destinations.
TELEGRAM_SOURCE_CHAT=-1001234567890

# Optional: SQLite database file path (relative to project root)
DATABASE_PATH=data/bot.db

# Optional: "copy" (no forward tag) or "forward" (shows original sender)
FORWARD_MODE=copy
